{
	"name": "omp-claude-bridge",
	"version": "0.8.1",
	"private": false,
	"description": "Oh My Pi extension that runs Claude Code via the Claude Agent SDK as a first-class provider with catalogue-driven model and context discovery.",
	"keywords": [
		"omp-package",
		"oh-my-pi",
		"extension",
		"claude-code",
		"claude-agent-sdk",
		"context-window",
		"1m-context"
	],
	"author": "Jonathan Borgwing (https://github.com/DevVig)",
	"contributors": [
		"Eli Dickinson (original pi-claude-bridge author, https://github.com/elidickinson)"
	],
	"license": "MIT",
	"homepage": "https://github.com/DevVig/omp-claude-bridge#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DevVig/omp-claude-bridge.git"
	},
	"bugs": {
		"url": "https://github.com/DevVig/omp-claude-bridge/issues"
	},
	"engines": {
		"node": ">=20"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE",
		"NOTICE",
		"tsconfig.json",
		"assets"
	],
	"scripts": {
		"smoke:context": "node --import tsx scripts/runtime-context-smoke.ts",
		"test": "node --import tsx --test tests/unit-*.mjs",
		"test:crossversion": "node --import tsx --test tests/crossversion-*.mjs",
		"test:unit": "node --import tsx --test tests/unit-*.mjs",
		"typecheck": "tsc --noEmit"
	},
	"type": "module",
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.3.274",
		"@anthropic-ai/sdk": "^0.126.0",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"cc-session-io": "^0.3.1",
		"change-case": "^5.4.4",
		"typebox": "^1.3.0",
		"zod": "^4.0.0"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-ai": ">=16.3.6",
		"@oh-my-pi/pi-agent-core": ">=16.3.6",
		"@oh-my-pi/pi-coding-agent": ">=16.3.6",
		"@oh-my-pi/pi-tui": ">=16.3.6",
		"@oh-my-pi/pi-utils": ">=16.3.6"
	},
	"peerDependenciesMeta": {
		"@oh-my-pi/pi-ai": {
			"optional": true
		},
		"@oh-my-pi/pi-agent-core": {
			"optional": true
		},
		"@oh-my-pi/pi-coding-agent": {
			"optional": true
		},
		"@oh-my-pi/pi-tui": {
			"optional": true
		},
		"@oh-my-pi/pi-utils": {
			"optional": true
		}
	},
	"devDependencies": {
		"@oh-my-pi/pi-agent-core": "18.2.8",
		"@oh-my-pi/pi-ai": "18.2.8",
		"@oh-my-pi/pi-catalog": "18.2.8",
		"@oh-my-pi/pi-coding-agent": "18.2.8",
		"@oh-my-pi/pi-tui": "18.2.8",
		"@oh-my-pi/pi-utils": "18.2.8",
		"@types/node": "^24.13.2",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"zod-4-4-3": "npm:zod@4.4.3",
		"zod-4-5-2": "npm:zod@4.5.2",
		"zod-4-5-3": "npm:zod@4.5.3",
		"zod-4-6-5": "npm:zod@4.6.5"
	},
	"trustedDependencies": [
		"esbuild"
	],
	"omp": {
		"extensions": [
			"./src/index.ts"
		]
	}
}
